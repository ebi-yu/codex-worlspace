{
  "name": "search-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm check && vite build",
    "test": "rm -rf build-tests && tsc -p tsconfig.test.json && node --test build-tests/test/**/*.test.js",
    "check": "tsc --noEmit",
    "lint": "oxlint extension/src test vite.config.mjs",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "validate": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.29.0",
    "typescript": "^6.0.3",
    "vite": "^7.2.2"
  }
}
